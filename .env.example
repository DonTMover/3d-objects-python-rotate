# Example environment variables for docker-compose
# Host port to map to web (uvicorn)
WEB_PORT=8000
# Host port to map to frontend (node http-server)
FRONTEND_PORT=3000
# Host port to map to Caddy
CADDY_PORT=8080

# Your Telegram bot token
BOT_TOKEN=

# Optional: override default WEBAPP URL (otherwise constructed as http://caddy:CADDY_PORT/ inside compose)
WEBAPP_PUBLIC_URL=
